<Window x:Class="Cartridge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NFS Client" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Mount Controls -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Label Content="NFS Share Settings" FontWeight="Bold"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Server:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="5,0,5,0" Name="ServerTextBox"/>
                <Label Grid.Column="2" Content="Drive Letter:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" Width="50" Name="DriveLetterComboBox"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Share Path:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Margin="5,0,0,0" Name="SharePathTextBox"/>
            </Grid>
            <Button Content="Mount Share" HorizontalAlignment="Right" Margin="0,10,0,0" 
                    Padding="20,5" Name="MountButton"/>
        </StackPanel>

        <!-- Mounted Shares List -->
        <GroupBox Grid.Row="1" Header="Mounted Shares">
            <ListView Name="MountedSharesListView">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Drive" Width="60"/>
                        <GridViewColumn Header="Server" Width="150"/>
                        <GridViewColumn Header="Share Path" Width="200"/>
                        <GridViewColumn Header="Status" Width="100"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>